OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# HaloPSA OAuth 2.0 client-credentials configuration.
# For Halo-hosted cloud, use https://YOUR-INSTANCE.halopsa.com/auth/token?tenant=YOUR_TENANT
# For self-hosted, use https://YOUR-HALO-HOST/auth/token
HALO_TOKEN_URL=https://your-instance.halopsa.com/auth/token?tenant=your-tenant
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
HALO_SCOPE=

# Streamable HTTP MCP endpoint exposed by your HaloPSA MCP server.
MCP_URL=https://your-halo-mcp.example.com/mcp
MCP_GET_TICKET_TOOL=get_one_ticket
# Optional. Set this only if your MCP server exposes an agent lookup tool.
MCP_GET_AGENT_TOOL=
MCP_AGENT_PERSONA_FIELD=ai_persona_style
MCP_TIMEOUT_MS=15000
FRAME_ANCESTORS=https://*.usehalo.com https://*.halopsa.com

# Required when any write-capable tool or CF runbook is enabled. Use a long,
# random value. It signs short-lived browser confirmation tokens.
CONFIRMATION_SECRET=
# Comma-separated exact names of additional write-capable CF runbooks.
# Example: CF_post_private_note,CF_reassign_ticket
CF_ALLOWED_WRITE_TOOLS=

# Optional stronger iframe-context protection. When enabled, the parent/proxy
# must provide HMAC-SHA256(ticket_id|agent_id|ticket_summary|ticket_description)
# as the context_signature URL parameter.
REQUIRE_SIGNED_CONTEXT=false
IFRAME_CONTEXT_SECRET=
