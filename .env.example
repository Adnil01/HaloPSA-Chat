OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Exact assistant origin, no trailing slash. HTTPS in production.
APP_ORIGIN=https://your-assistant.vercel.app
# Exact HTTPS tenant origin(s), space-separated. No wildcards.
FRAME_ANCESTORS=https://your-instance.halopsa.com

# Independent random server-only secrets, each at least 32 bytes.
# The trusted launch backend also needs IFRAME_CONTEXT_SECRET and APP_ORIGIN.
IFRAME_CONTEXT_SECRET=
CONFIRMATION_SECRET=

# Required production shared Redis REST store with EVAL and SET NX.
SECURITY_REDIS_REST_URL=
SECURITY_REDIS_REST_TOKEN=
# Optional DEVELOPMENT ONLY fallback. Production always requires Redis.
# SECURITY_STORE=memory
RATE_LIMIT_MAX_REQUESTS=30

# Halo OAuth service identity. Restrict permissions to required operations.
HALO_TOKEN_URL=https://your-instance.halopsa.com/auth/token?tenant=your-tenant
HALOPSA_BASE_URL=https://your-instance.halopsa.com
HALOPSA_TENANT=your-tenant
HALOPSA_CLIENT_ID=
HALOPSA_CLIENT_SECRET=
# Use the narrowest scope supported by your Halo API application.
HALO_SCOPE=all

MCP_URL=https://your-halo-mcp.example.com/mcp
MCP_GET_TICKET_TOOL=get_one_ticket
MCP_GET_AGENT_TOOL=
MCP_AGENT_PERSONA_FIELD=CFTechnicianCommunicationStyle
MCP_TIMEOUT_MS=15000
# Additional exact tool names, independently granted by each signed launch.
# Unknown tools require confirmation regardless of MCP readOnly hints.
MCP_ALLOWED_TOOLS=
